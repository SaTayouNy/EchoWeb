# Пусто — интерфейс работает на демо-данных (src/mock-data.js).
# Адрес API, который вызывает браузер. Если nginx проксирует /api на бэкенд — оставьте /api.
VITE_API_URL=

# Только для `npm run dev`: куда перенаправлять запросы /api (локальный бэкенд).
VITE_DEV_PROXY=

# ── Аналитика (v10.40) ──
# События уходят на POST {VITE_API_URL}/events (при /api → /api/events). Пустой VITE_API_URL = демо, в сеть ничего не уходит.
# development / staging / test → is_test=true и вывод событий в консоль; production → is_test=false.
VITE_ANALYTICS_ENV=development
# ID тестовых аккаунтов через запятую (UUID пользователей бэкенда): их события помечаются is_test=true.
VITE_ANALYTICS_TEST_USER_IDS=
# Номер счётчика Яндекс Метрики. Пусто — Метрика не загружается. На localhost не работает никогда.
VITE_YANDEX_METRIKA_ID=
